{
  "name": "poker-game",
  "version": "0.0.1",
  "private": true,
  "description": "Texas Hold'em rules, to be played through Remote State",
  "author": "Malte Muth",
  "license": "ISC",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "default": "./dist/plugin/index.js"
    },
    "./odds": {
      "types": "./dist/odds/index.d.ts",
      "default": "./dist/odds/index.js"
    }
  },
  "engines": {
    "node": ">=24",
    "npm": ">=10.8.2"
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run typecheck && node --import tsx --test \"__tests__/**/*.test.ts\"",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "download:hands": "scripts/download-hand-histories.sh",
    "verify:hands": "node --import tsx --test \"verify/**/*.test.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "smol-toml": "^1.9.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "@malte.muth/poker-hands": "file:../poker-hands/packages/library",
    "@malte.muth/poker-hands-wasm": "file:../poker-hands/packages/wasm",
    "@malte.muth/remote-state": "file:../remote-state/packages/remote-state"
  }
}
